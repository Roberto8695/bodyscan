// Body Scan Medical Center — MVP LMS + blog + sitio institucional
// Prisma 7. La URL de conexión se define en prisma7.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EDITOR
  STUDENT
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonKind {
  VIDEO
  TEXT
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

// IDENTIDAD Y ACCESO
model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(255)
  fullName        String    @map("full_name") @db.VarChar(160)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles             UserRoleAssignment[]
  sessions          UserSession[]
  passwordResets    PasswordResetToken[]
  enrollments       Enrollment[]
  authoredArticles  Article[]            @relation("ArticleAuthor")
  publishedArticles Article[]            @relation("ArticlePublisher")
  grantedAccess     EnrollmentAccess[]   @relation("AccessGrantAdministrator")

  @@map("users")
}

model UserRoleAssignment {
  userId    String   @map("user_id") @db.Uuid
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

// ARCHIVOS Y VIDEOS: los binarios se almacenan en un proveedor externo.
model MediaAsset {
  id           String          @id @default(uuid()) @db.Uuid
  kind         MediaKind
  visibility   MediaVisibility @default(PRIVATE)
  provider     String          @db.VarChar(40)
  providerKey  String          @map("provider_key") @db.VarChar(500)
  originalName String?         @map("original_name") @db.VarChar(255)
  mimeType     String?         @map("mime_type") @db.VarChar(120)
  sizeBytes    BigInt?         @map("size_bytes")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  lessonVideos       Lesson[]         @relation("LessonVideo")
  lessonFiles        LessonResource[]
  courseCovers       Course[]         @relation("CourseCover")
  articleCovers      Article[]        @relation("ArticleCover")
  professionalPhotos Professional[]   @relation("ProfessionalPhoto")

  @@unique([provider, providerKey])
  @@map("media_assets")
}

// ACADEMIA
model Course {
  id          String            @id @default(uuid()) @db.Uuid
  slug        String            @unique @db.VarChar(180)
  title       String            @db.VarChar(200)
  summary     String?           @db.Text
  description String?           @db.Text
  price       Decimal           @db.Decimal(12, 2)
  currency    String            @default("BOB") @db.Char(3)
  accessDays  Int               @map("access_days")
  status      PublicationStatus @default(DRAFT)
  coverId     String?           @map("cover_id") @db.Uuid
  publishedAt DateTime?         @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  cover       MediaAsset?    @relation("CourseCover", fields: [coverId], references: [id], onDelete: SetNull)
  modules     CourseModule[]
  enrollments Enrollment[]

  @@index([status, publishedAt])
  @@map("courses")
}

model CourseModule {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  title     String   @db.VarChar(200)
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  lessons Lesson[]

  @@unique([courseId, position])
  @@map("course_modules")
}

model Lesson {
  id        String            @id @default(uuid()) @db.Uuid
  moduleId  String            @map("module_id") @db.Uuid
  title     String            @db.VarChar(200)
  kind      LessonKind        @default(VIDEO)
  body      String?           @db.Text
  videoId   String?           @map("video_id") @db.Uuid
  position  Int
  status    PublicationStatus @default(DRAFT)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  module    CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  video     MediaAsset?      @relation("LessonVideo", fields: [videoId], references: [id], onDelete: SetNull)
  resources LessonResource[]

  @@unique([moduleId, position])
  @@map("lessons")
}

model LessonResource {
  lessonId String     @map("lesson_id") @db.Uuid
  mediaId  String     @map("media_id") @db.Uuid
  position Int
  lesson   Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  media    MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([lessonId, mediaId])
  @@unique([lessonId, position])
  @@map("lesson_resources")
}

// INSCRIPCIONES Y ACCESO
// La compra se coordina fuera del sistema por WhatsApp. Un administrador crea
// la inscripción y habilita el acceso después de confirmar el pago internamente.
model Enrollment {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  courseId  String             @map("course_id") @db.Uuid
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  course    Course             @relation(fields: [courseId], references: [id], onDelete: Restrict)
  access    EnrollmentAccess[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

// Historial de habilitaciones y renovaciones manuales.
// La vigencia se deriva de startsAt, expiresAt y revokedAt.
model EnrollmentAccess {
  id           String    @id @default(uuid()) @db.Uuid
  enrollmentId String    @map("enrollment_id") @db.Uuid
  grantedById  String    @map("granted_by_id") @db.Uuid
  startsAt     DateTime  @map("starts_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  reason       String?   @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  grantedBy  User       @relation("AccessGrantAdministrator", fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([enrollmentId, startsAt, expiresAt])
  @@map("enrollment_access")
}

// BLOG
model Article {
  id            String            @id @default(uuid()) @db.Uuid
  slug          String            @unique @db.VarChar(200)
  title         String            @db.VarChar(220)
  excerpt       String?           @db.VarChar(500)
  content       Json
  status        PublicationStatus @default(DRAFT)
  authorId      String            @map("author_id") @db.Uuid
  publishedById String?           @map("published_by_id") @db.Uuid
  coverId       String?           @map("cover_id") @db.Uuid
  publishedAt   DateTime?         @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  author      User                  @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  publishedBy User?                 @relation("ArticlePublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  cover       MediaAsset?           @relation("ArticleCover", fields: [coverId], references: [id], onDelete: SetNull)
  categories  ArticleCategoryLink[]

  @@index([status, publishedAt])
  @@map("articles")
}

model ArticleCategory {
  id       String                @id @default(uuid()) @db.Uuid
  slug     String                @unique @db.VarChar(120)
  name     String                @unique @db.VarChar(120)
  articles ArticleCategoryLink[]

  @@map("article_categories")
}

model ArticleCategoryLink {
  articleId  String          @map("article_id") @db.Uuid
  categoryId String          @map("category_id") @db.Uuid
  article    Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([articleId, categoryId])
  @@index([categoryId])
  @@map("article_category_links")
}

// SITIO INSTITUCIONAL
model Specialty {
  id            String                  @id @default(uuid()) @db.Uuid
  slug          String                  @unique @db.VarChar(160)
  name          String                  @unique @db.VarChar(160)
  description   String?                 @db.Text
  isPublished   Boolean                 @default(false) @map("is_published")
  position      Int                     @default(0)
  professionals ProfessionalSpecialty[]
  services      Service[]

  @@map("specialties")
}

model Professional {
  id          String                  @id @default(uuid()) @db.Uuid
  fullName    String                  @map("full_name") @db.VarChar(160)
  biography   String?                 @db.Text
  photoId     String?                 @map("photo_id") @db.Uuid
  isPublished Boolean                 @default(false) @map("is_published")
  position    Int                     @default(0)
  photo       MediaAsset?             @relation("ProfessionalPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  specialties ProfessionalSpecialty[]

  @@map("professionals")
}

model ProfessionalSpecialty {
  professionalId String       @map("professional_id") @db.Uuid
  specialtyId    String       @map("specialty_id") @db.Uuid
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  specialty      Specialty    @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@id([professionalId, specialtyId])
  @@index([specialtyId])
  @@map("professional_specialties")
}

model Service {
  id          String     @id @default(uuid()) @db.Uuid
  specialtyId String?    @map("specialty_id") @db.Uuid
  slug        String     @unique @db.VarChar(160)
  name        String     @db.VarChar(160)
  description String?    @db.Text
  isPublished Boolean    @default(false) @map("is_published")
  position    Int        @default(0)
  specialty   Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)

  @@index([specialtyId])
  @@map("services")
}
